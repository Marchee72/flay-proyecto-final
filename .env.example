# Base de datos — la aplicacion siempre se conecta como flay_app (I-02, RN-12)
DATABASE_URL=
# Rol propietario: solo para migraciones (prisma migrate deploy/dev)
DIRECT_DATABASE_URL=
# Cadena administradora: solo para `npm run db:preparar` (crea los dos roles)
ADMIN_DATABASE_URL=
# Base sombra para db:drift (I-01): con el rol administrador, porque Prisma la
# resetea y hay que reinstalar las extensiones en cada corrida
SHADOW_DATABASE_URL=
# Secreto de sesion — se genera con `npx --yes auth secret`, nunca se versiona
AUTH_SECRET=
# Almacenamiento de objetos: comprobantes, con subida directa del navegador
BLOB_READ_WRITE_TOKEN=
# Correo transaccional: invitaciones de usuario
RESEND_API_KEY=
# Semilla de arranque (FR-005): crea el unico administrador inicial.
# La clave nunca se versiona y se rota apenas el administrador entra.
ADMIN_SEMILLA_CORREO=
ADMIN_SEMILLA_CLAVE=
# Solo para la demostracion (§ 13.5): con esta clave, `npm run semilla` deja a los
# siete usuarios ficticios activos y entrando con ella. Vacia en produccion real.
DEMO_CLAVE=
# Asistencia automatica (§ 14.3, research R-02 de 004-servicios). La implementacion
# la elige src/aplicacion/dependencias.ts: FLAY_ASISTENCIA=determinista → la de
# pruebas; GEMINI_API_KEY presente → el proveedor; ninguna → la nula (degradacion).
FLAY_ASISTENCIA=
GEMINI_API_KEY=
# Secreto de la tarea programada que refresca las vistas de indicadores (FR-018)
CRON_SECRET=
