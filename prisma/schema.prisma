// Esquema inicial de Flay (001-andamiaje).
// Solo contiene lo transversal: ninguna entidad de negocio nace en esta etapa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // La aplicacion y las pruebas de integracion se conectan como flay_app (I-02).
  url               = env("DATABASE_URL")
  // Las migraciones corren como flay_owner: es el unico rol con DDL.
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Asiento de auditoria (RF-26, RN-15, RNF-12).
/// La escribe unicamente fn_auditar(); flay_app no tiene INSERT/UPDATE/DELETE/TRUNCATE.
model BitacoraAuditoria {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momento       DateTime  @default(now()) @db.Timestamptz(6)
  usuario       String    @db.Text
  tabla         String    @db.Text
  clave         String    @db.Text
  operacion     Operacion
  anterior      Json?     @db.JsonB
  posterior     Json?     @db.JsonB
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([tabla, clave])
  @@index([momento])
}

enum Operacion {
  INSERTA
  MODIFICA
  BORRA
}

/// Un edificio de propiedad horizontal. Raiz del aislamiento: casi toda entidad
/// cuelga de el (regla RN-12 § 7.2).
model Consorcio {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  administradoraId String   @map("administradora_id") @db.Uuid
  nombre           String   @db.Text
  direccion        String   @db.Text
  localidad        String   @db.Text
  cuit             String   @unique @db.Text
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  administradora Administradora @relation(fields: [administradoraId], references: [id])
  unidades       Unidad[]
  proveedores    Proveedor[]
  periodos       Periodo[]
  gastos         Gasto[]

  @@index([administradoraId])
}

/// Empresa que administra una cartera de consorcios. Segundo eje del
/// aislamiento: el punto 9 lo compromete en el factor 13 y el punto 7 no lo
/// tenia (ver correcciones-documentales.md).
model Administradora {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razonSocial   String   @map("razon_social") @db.Text
  cuit          String   @unique @db.Text
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  consorcios     Consorcio[]
  habilitaciones HabilitacionAdministradora[]
}

/// Efecto externo que fallo y hay que reintentar: correo o confirmacion de
/// subida (FR-006b). El camino feliz tambien pasa por aca, para que el de
/// reintento no se ejercite solo cuando el proveedor falla.
model TrabajoPendiente {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           TipoTrabajo
  carga          Json          @db.JsonB
  estado         EstadoTrabajo @default(pendiente)
  intentos       Int           @default(0)
  /// El vencimiento se compara contra `now()` **de la base**, asi que la hora
  /// la pone la base y no el proceso: `encolar` inserta sin esta columna a
  /// proposito (FR-006b).
  proximoIntento DateTime      @default(now()) @map("proximo_intento") @db.Timestamptz(6)
  ultimoError    String?       @map("ultimo_error") @db.Text
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([estado, proximoIntento])
}

enum TipoTrabajo {
  invitacion
  confirmacion_subida
}

enum EstadoTrabajo {
  pendiente
  despachado
  agotado
}

/// Persona fisica, con o sin usuario. Datos personales bajo Ley 25.326 (RNF-13).
model Persona {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @db.Text
  apellido      String   @db.Text
  documento     String?  @unique @db.Text
  correo        String?  @unique @db.Text
  telefono      String?  @db.Text
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario     Usuario?
  ocupaciones Ocupacion[]
}

/// Credencial de acceso de una persona.
model Usuario {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personaId       String        @unique @map("persona_id") @db.Uuid
  correo          String        @unique @db.Text
  claveDerivada   String?       @map("clave_derivada") @db.Text
  estado          EstadoUsuario @default(invitado)
  bloqueadoHasta  DateTime?     @map("bloqueado_hasta") @db.Timestamptz(6)
  invitacionHash  String?       @map("invitacion_hash") @db.Text
  invitacionVence DateTime?     @map("invitacion_vence") @db.Timestamptz(6)
  creadoEn        DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  persona                      Persona                      @relation(fields: [personaId], references: [id])
  habilitaciones               Habilitacion[]
  habilitacionesPlataforma     HabilitacionPlataforma[]
  habilitacionesAdministradora HabilitacionAdministradora[]
}

/// Cada intento, exitoso o no, con su origen. Cinco fallos seguidos bloquean
/// quince minutos (FR-001b). Se guarda aunque la cuenta no exista.
model IntentoInicioSesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correoProbado String   @map("correo_probado") @db.Text
  origen        String   @db.Text
  exitoso       Boolean
  momento       DateTime @default(now()) @db.Timestamptz(6)

  @@index([correoProbado, momento])
}

/// Permiso vigente de un usuario sobre un consorcio, con rol.
/// **Es la tabla que materializa el Principio I.**
model Habilitacion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  consorcioId   String    @map("consorcio_id") @db.Uuid
  rol           Rol
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, consorcioId, rol])
  @@index([usuarioId, consorcioId])
}

enum EstadoUsuario {
  invitado
  activo
  suspendido
}

enum Rol {
  administrador
  consejo
  consorcista
}

/// Super administrador de la plataforma: configuracion general, alta de
/// administradoras y de consorcios (FR-007b). No se puede autorizar por par
/// (rol, consorcio) porque al crear el primero no hay ninguno.
///
/// Va en tabla propia y no como `consorcio_id` nulo en `Habilitacion`: un nulo
/// en la tabla que materializa el Principio I es la clase de agujero que
/// despues filtra datos.
model HabilitacionPlataforma {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

/// Habilitacion sobre toda la cartera de una administradora (FR-007). Su
/// existencia vigente es el rol: da administrador efectivo sobre cada consorcio
/// de esa empresa, y sobre ninguno de otra.
model HabilitacionAdministradora {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  administradoraId String    @map("administradora_id") @db.Uuid
  vigenciaDesde    DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta    DateTime? @map("vigencia_hasta") @db.Date
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  administradora Administradora @relation(fields: [administradoraId], references: [id])

  @@unique([usuarioId, administradoraId])
}

/// Unidad funcional con su coeficiente vigente (RF-02) — **economica**.
///
/// Invariante: por cada consorcio con al menos una unidad, la suma de los
/// coeficientes es exactamente 100.00000000. Lo impone un disparador de
/// restriccion diferido escrito a mano en la migracion, no el codigo
/// (regla RN-01, FR-011b, FR-011c).
model Unidad {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consorcioId   String     @map("consorcio_id") @db.Uuid
  designacion   String     @db.Text
  /// Punto 7: una unidad funcional es un departamento, una cochera, un local o
  /// una baulera. No cambia el prorrateo —todas tributan por su coeficiente—,
  /// pero sin el tipo una cochera solo se distingue si alguien la nombro asi.
  tipo          TipoUnidad @default(departamento)
  coeficiente   Decimal    @db.Decimal(11, 8)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime   @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  consorcio   Consorcio              @relation(fields: [consorcioId], references: [id])
  historico   CoeficienteHistorico[]
  ocupaciones Ocupacion[]

  @@unique([consorcioId, designacion])
  @@index([consorcioId])
}

enum TipoUnidad {
  departamento
  cochera
  local
  baulera
}

/// Coeficiente de una unidad con su rango de vigencia (regla RN-02) —
/// **economica**. Permite reconstruir una liquidacion pasada: sin el, cambiar
/// un coeficiente reescribiria la historia.
///
/// No lleva `consorcio_id`: cuelga de `Unidad`, que si lo lleva, y se alcanza
/// siempre a traves de ella.
model CoeficienteHistorico {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadId      String    @map("unidad_id") @db.Uuid
  coeficiente   Decimal   @db.Decimal(11, 8)
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  unidad Unidad @relation(fields: [unidadId], references: [id])

  @@index([unidadId, vigenciaDesde])
}

/// Vinculo entre una persona y una unidad (FR-008). El tipo no es un rol: es la
/// naturaleza del vinculo, y decide a quien se le cobra la expensa.
///
/// La vigencia va como **rango de fechas** de la base, no como dos columnas: es
/// lo que permite la restriccion de exclusion que impide dos inquilinos
/// vigentes sobre la misma unidad (regla RN-09). El mapeador no modela el tipo
/// de rango, asi que la columna se declara no soportada y el repositorio la lee
/// y la escribe con consulta cruda (research R-04).
model Ocupacion {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadId      String                   @map("unidad_id") @db.Uuid
  personaId     String                   @map("persona_id") @db.Uuid
  tipo          TipoOcupacion
  vigencia      Unsupported("daterange")
  creadoEn      DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime                 @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  unidad  Unidad  @relation(fields: [unidadId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id])

  @@index([unidadId])
  @@index([personaId])
}

enum TipoOcupacion {
  propietario
  inquilino
}

/// Rubro de gasto. Catalogo **global**: no cuelga de consorcio, para que dos
/// edificios no llamen distinto a la misma cosa y los indicadores de la etapa 4
/// puedan compararse. Lo carga una semilla acordada con el cliente (FR-014);
/// el alta y la modificacion estan diferidas (§ 9.11).
model RubroGasto {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String        @unique @db.Text
  clasificacion Clasificacion
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  gastos     Gasto[]
  habituales Proveedor[]
}

/// Ordinario o extraordinario (regla RN-04). Se **congela en el gasto** al
/// registrarlo: si el rubro se reclasificara despues, una liquidacion vieja no
/// puede cambiar de sentido.
enum Clasificacion {
  ordinario
  extraordinario
}

/// Proveedor del consorcio (RF-05). Raiz del grafo de la etapa: no tiene
/// dependencias obligatorias y se construye antes que `Gasto`. Sin baja (§ 9.11).
model Proveedor {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consorcioId     String   @map("consorcio_id") @db.Uuid
  razonSocial     String   @map("razon_social") @db.Text
  cuit            String   @db.Text
  rubroHabitualId String?  @map("rubro_habitual_id") @db.Uuid
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  consorcio     Consorcio   @relation(fields: [consorcioId], references: [id])
  rubroHabitual RubroGasto? @relation(fields: [rubroHabitualId], references: [id])
  gastos        Gasto[]

  @@unique([consorcioId, cuit])
  @@index([consorcioId])
}

/// Mes de un consorcio — **economica**.
///
/// El enum declara los cuatro estados porque `src/dominio/periodos/estado.ts`
/// publica el contrato minimo que comparte `003-liquidacion` (FR-017, M-04),
/// pero **esta etapa solo produce `abierto`**: cerrar, liquidar y anular son
/// alcance de la etapa siguiente (FR-024).
model Periodo {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consorcioId   String        @map("consorcio_id") @db.Uuid
  anio          Int
  mes           Int
  estado        EstadoPeriodo @default(abierto)
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  consorcio Consorcio @relation(fields: [consorcioId], references: [id])
  gastos    Gasto[]

  @@unique([consorcioId, anio, mes])
  @@index([consorcioId])
}

enum EstadoPeriodo {
  abierto
  cerrado
  liquidado
  anulado
}

/// Gasto imputado a un periodo — **economica**.
model Gasto {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consorcioId   String        @map("consorcio_id") @db.Uuid
  periodoId     String        @map("periodo_id") @db.Uuid
  rubroId       String        @map("rubro_id") @db.Uuid
  proveedorId   String?       @map("proveedor_id") @db.Uuid
  importe       Decimal       @db.Decimal(14, 2)
  clasificacion Clasificacion
  fecha         DateTime      @db.Date
  descripcion   String        @db.Text
  cargadoPor    String        @map("cargado_por") @db.Uuid
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  consorcio    Consorcio     @relation(fields: [consorcioId], references: [id])
  periodo      Periodo       @relation(fields: [periodoId], references: [id])
  rubro        RubroGasto    @relation(fields: [rubroId], references: [id])
  proveedor    Proveedor?    @relation(fields: [proveedorId], references: [id])
  comprobantes Comprobante[]

  @@index([consorcioId, periodoId, rubroId])
  @@index([consorcioId, fecha])
}

/// Comprobante digitalizado — **economica**. El archivo **no** esta en la base:
/// lo que se guarda es su ubicacion en el almacenamiento de objetos.
///
/// `pendiente` es el estado mientras la subida directa no confirmo (FR-018b):
/// el gasto ya existe y el comprobante todavia no.
model Comprobante {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gastoId       String            @map("gasto_id") @db.Uuid
  claveObjeto   String            @map("clave_objeto") @db.Text
  tipoContenido String            @map("tipo_contenido") @db.Text
  bytes         Int
  estado        EstadoComprobante @default(pendiente)
  creadoEn      DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime          @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  gasto Gasto @relation(fields: [gastoId], references: [id])

  @@index([gastoId])
}

enum EstadoComprobante {
  pendiente
  disponible
  fallido
}
