{
  "name": "flay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0 <23",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:dominio": "vitest run --project dominio",
    "test:integracion": "vitest run --project integracion",
    "test:e2e": "playwright test --project=escritorio --project=telefono --project=degradacion",
    "test:a11y": "playwright test --project=a11y",
    "medir:p95": "node scripts/medir-p95.mjs",
    "medir:liquidacion": "vitest run --project integracion pruebas/integracion/medicion-liquidacion.spec.ts",
    "indicadores:refrescar": "node scripts/refrescar-vistas.mjs",
    "validar:indicadores": "node scripts/validar-indicadores.mjs",
    "exportar:verificar": "node scripts/exportar-verificar.mjs",
    "validar:planillas": "vitest run --project planillas",
    "docs:versiones": "node scripts/verificar-versiones.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:preparar": "node scripts/preparar-bd.mjs",
    "semilla": "node scripts/semilla.mjs",
    "semilla:volumen": "node scripts/semilla-volumen.mjs",
    "semilla:arranque": "node scripts/semilla-arranque.mjs",
    "semilla:rubros": "node prisma/semilla-rubros.ts",
    "db:drift": "node scripts/db-drift.mjs",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm run test:dominio && npm run db:deploy && npm run db:drift && npm run test:integracion && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.7.0",
    "@react-pdf/renderer": "4.1.3",
    "@vercel/blob": "2.8.0",
    "decimal.js": "10.4.3",
    "lucide-react": "0.525.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "2.15.0",
    "resend": "6.26.0",
    "unpdf": "1.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.9.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.20.0",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
