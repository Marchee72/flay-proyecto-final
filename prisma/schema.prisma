// Esquema inicial de Flay (001-andamiaje).
// Solo contiene lo transversal: ninguna entidad de negocio nace en esta etapa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // La aplicacion y las pruebas de integracion se conectan como flay_app (I-02).
  url               = env("DATABASE_URL")
  // Las migraciones corren como flay_owner: es el unico rol con DDL.
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Asiento de auditoria (RF-26, RN-15, RNF-12).
/// La escribe unicamente fn_auditar(); flay_app no tiene INSERT/UPDATE/DELETE/TRUNCATE.
model BitacoraAuditoria {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momento       DateTime  @default(now()) @db.Timestamptz(6)
  usuario       String    @db.Text
  tabla         String    @db.Text
  clave         String    @db.Text
  operacion     Operacion
  anterior      Json?     @db.JsonB
  posterior     Json?     @db.JsonB
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([tabla, clave])
  @@index([momento])
}

enum Operacion {
  INSERTA
  MODIFICA
  BORRA
}

/// Un edificio de propiedad horizontal. Raiz del aislamiento: casi toda entidad
/// cuelga de el (regla RN-12 § 7.2).
model Consorcio {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @db.Text
  direccion     String   @db.Text
  localidad     String   @db.Text
  cuit          String   @unique @db.Text
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
}

/// Efecto externo que fallo y hay que reintentar: correo o confirmacion de
/// subida (FR-006b). El camino feliz tambien pasa por aca, para que el de
/// reintento no se ejercite solo cuando el proveedor falla.
model TrabajoPendiente {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           TipoTrabajo
  carga          Json          @db.JsonB
  estado         EstadoTrabajo @default(pendiente)
  intentos       Int           @default(0)
  proximoIntento DateTime      @default(now()) @map("proximo_intento") @db.Timestamptz(6)
  ultimoError    String?       @map("ultimo_error") @db.Text
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([estado, proximoIntento])
}

enum TipoTrabajo {
  invitacion
  confirmacion_subida
}

enum EstadoTrabajo {
  pendiente
  despachado
  agotado
}

/// Persona fisica, con o sin usuario. Datos personales bajo Ley 25.326 (RNF-13).
model Persona {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @db.Text
  apellido      String   @db.Text
  documento     String?  @unique @db.Text
  correo        String?  @unique @db.Text
  telefono      String?  @db.Text
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario?
}

/// Credencial de acceso de una persona.
model Usuario {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personaId       String        @unique @map("persona_id") @db.Uuid
  correo          String        @unique @db.Text
  claveDerivada   String?       @map("clave_derivada") @db.Text
  estado          EstadoUsuario @default(invitado)
  bloqueadoHasta  DateTime?     @map("bloqueado_hasta") @db.Timestamptz(6)
  invitacionHash  String?       @map("invitacion_hash") @db.Text
  invitacionVence DateTime?     @map("invitacion_vence") @db.Timestamptz(6)
  creadoEn        DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  persona             Persona               @relation(fields: [personaId], references: [id])
  habilitaciones      Habilitacion[]
  HabilitacionCartera HabilitacionCartera[]
}

/// Cada intento, exitoso o no, con su origen. Cinco fallos seguidos bloquean
/// quince minutos (FR-001b). Se guarda aunque la cuenta no exista.
model IntentoInicioSesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correoProbado String   @map("correo_probado") @db.Text
  origen        String   @db.Text
  exitoso       Boolean
  momento       DateTime @default(now()) @db.Timestamptz(6)

  @@index([correoProbado, momento])
}

/// Permiso vigente de un usuario sobre un consorcio, con rol.
/// **Es la tabla que materializa el Principio I.**
model Habilitacion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  consorcioId   String    @map("consorcio_id") @db.Uuid
  rol           Rol
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, consorcioId])
}

enum EstadoUsuario {
  invitado
  activo
  suspendido
}

enum Rol {
  administrador
  consejo
  consorcista
}

/// Habilitacion de cartera: el cuarto rol, por encima de los tres del punto 12.
/// Es quien da de alta consorcios, que no se puede autorizar por par (rol,
/// consorcio) porque todavia no hay consorcio.
///
/// Va en tabla propia y no como `consorcio_id` nulo en `Habilitacion`: un nulo
/// en la tabla que materializa el Principio I es la clase de agujero que
/// despues filtra datos.
model HabilitacionCartera {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}
